# YOUPI PG - Environment Configuration Template
# ============================================================
# Copy this file to .env and configure for your deployment.
# NEVER commit .env with real secrets to version control.
# ============================================================

# --- NODE ENVIRONMENT ---
NODE_ENV=development

# --- SERVICE PORTS (Strictly Non-Docker Standard Host Topology) ---
CONTROL_CENTER_PORT=8090
PAYMENT_API_PORT=6100
CHECKOUT_PORTAL_PORT=7000
MERCHANT_ADMIN_PORT=6001
HELP_PORTAL_PORT=3000
GMAIL_OBSERVER_PORT=6003
SMS_OBSERVER_PORT=6002
COIN_WALLET_STORE_PORT=5000

# --- PUBLIC SERVICE URLS ---
BASE_PAYMENT_API_URL=http://localhost:6100
BASE_CHECKOUT_URL=http://localhost:7000
BASE_ADMIN_URL=http://localhost:6001
BASE_HELP_URL=http://localhost:3000
BASE_DEMO_STORE_URL=http://localhost:5000

# --- DATABASE CONFIGURATION ---
# PostgreSQL connection string:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/youpi_pg
# SQLite local file fallback for instant zero-dependency testing:
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=./data/youpi_pg.sqlite

# --- ACCESS CONTROL (REQUIRED) -------------------------------------------------
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Protected features stay DISABLED (HTTP 503) until these are set to strong values.
# The example values below are rejected on purpose.
#
# Token the merchant admin panel uses server-side to call /api/v1/admin/* on the Payment API.
# Operators can also send it as the "X-Admin-Token" header.
ADMIN_API_TOKEN=change_me_to_a_long_random_admin_api_token_value
# Token the Gmail / SMS observer services send ("X-Observer-Token") to report bank alerts.
OBSERVER_INGEST_TOKEN=change_me_to_a_long_random_observer_token_value
# Login for the merchant admin panel (HTTP Basic auth). Password: 12+ characters.
ADMIN_PANEL_USER=admin
ADMIN_PANEL_PASSWORD=
# Supervisor (control center) and SMS observer only listen on loopback by default.
CONTROL_CENTER_HOST=127.0.0.1
SMS_OBSERVER_HOST=127.0.0.1

# --- REQUEST HARDENING ---
# Browser origins allowed to call the public checkout API (comma separated).
# Leave empty to allow any origin (public checkout endpoints only; admin routes never allow CORS).
CORS_ALLOWED_ORIGINS=
# Set to 1 only if a reverse proxy on ANOTHER host forwards requests (X-Forwarded-For is then trusted).
# Requests arriving from localhost (for example cloudflared) are handled automatically.
TRUST_PROXY=
# Public payment creations allowed per client IP per minute.
CREATE_PAYMENT_RATE_LIMIT_PER_MIN=60
# Largest single payment accepted, in rupees.
MAX_PAYMENT_AMOUNT_RUPEES=200000
# Development only: echo OTP codes in API responses (never set in production).
YOUPI_DEV_OTP=
# Show internal error messages in API responses (debugging only).
YOUPI_DEBUG_ERRORS=

# --- CRYPTOGRAPHIC SECRETS (Generate using crypto.randomBytes(32).toString('hex')) ---
# Master 256-bit encryption key for sensitive records (OAuth tokens, device keys):
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Session & JWT secret:
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
# Legacy admin credentials (used as the panel login only if ADMIN_PANEL_* are unset):
INITIAL_ADMIN_EMAIL=admin@youpi.local
INITIAL_ADMIN_PASSWORD=AdminSecurePassword123!

# --- TIMING & QUEUE ENGINE CONSTANTS ---
# Payment active window (milliseconds, default 5 minutes = 300000):
PAYMENT_ACTIVE_WINDOW_MS=300000
# Payment processing verification window (milliseconds, default 30 seconds = 30000):
PAYMENT_PROCESSING_WINDOW_MS=30000
# Late observation grace evaluation window (milliseconds, default 30 minutes = 1800000):
LATE_OBSERVATION_WINDOW_MS=1800000

# --- GMAIL OBSERVER CONFIGURATION ---
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
# Must match the redirect URI registered in your own Google Cloud OAuth client.
GMAIL_REDIRECT_URI=http://localhost:6003/oauth/callback
GMAIL_POLL_INTERVAL_MS=5000

# --- SMS / GOOGLE MESSAGES OBSERVER ---
SMS_OBSERVER_POLL_INTERVAL_MS=3000

# --- ANDROID OBSERVER SECURITY ---
# REQUIRED to pair phones. 32+ random characters; the example value is rejected.
ANDROID_ENROLLMENT_SECRET=android_pairing_enrollment_secret_key_32_chars
ANDROID_HEARTBEAT_TIMEOUT_MS=180000

# --- DEMO STORE ---
# Webhook secret for the demo store. If unset, a random secret is generated for the default
# merchant on first run; copy it from the admin panel into your own webhook receiver.
COIN_STORE_WEBHOOK_SECRET=

# --- WEBHOOK ENGINE ---
WEBHOOK_MAX_RETRIES=5
WEBHOOK_INITIAL_BACKOFF_MS=5000

# --- WHITE-LABEL BRANDING ---
DEFAULT_APP_NAME="YOUPI PG"
DEFAULT_PRIMARY_COLOR="#2563eb"
DEFAULT_SUPPORT_EMAIL="support@youpi.local"

# --- CLOUDFLARE TUNNEL ---
# Paste either the bare tunnel token or "cloudflared tunnel run --token <TOKEN>".
# The command is never run through a shell; only cloudflared is launched.
# CLOUDFLARE_TUNNEL_COMMAND=
# Optional full path to cloudflared if it is not on PATH:
# CLOUDFLARED_PATH=
